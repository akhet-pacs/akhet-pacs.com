---
import ContactActions from "../components/ContactActions.astro";
import { useDict } from "../i18n";

const t = useDict(Astro.currentLocale).clinics;
---

<section class="section-tight cta">
  <div class="shell-narrow cta__inner">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2>{t.title}</h2>
    <p class="lede">{t.lede}</p>
    <ContactActions message={t.whatsappMessage} whatsappLabel={t.btnWhatsapp} />
  </div>
</section>

<style>
  .cta {
    background: var(--surface);
    border-top: 1px solid var(--rule-color);
  }

  .cta__inner {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
</style>
